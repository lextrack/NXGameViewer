{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run tests",
      "type": "shell",
      "command": "ctest --preset debug",
      "dependsOn": "Build",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
